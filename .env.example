# ApplyPilot Environment Configuration
# Copy to ~/.applypilot/.env and fill in your values.

# LLM Provider
# Default: Claude Code CLI on your Claude Pro/Max plan (no key needed) when `claude` is on PATH
# and no API key below is set. Force a provider with LLM_PROVIDER.
# LLM_PROVIDER=claude      # claude | gemini | openai | local
# CLAUDE_MODEL=sonnet      # one Claude model for every task
# CLAUDE_MODEL_SCORE=haiku # per-task Claude models: SCORE, EXTRACT, TAILOR, JUDGE, COVER
# CLAUDE_MODEL_TAILOR=sonnet
# GEMINI_API_KEY=          # Gemini 2.0 Flash
# OPENAI_API_KEY=          # OpenAI (GPT-4o-mini)
# LLM_URL=http://127.0.0.1:8080/v1  # Local LLM (llama.cpp, Ollama)
# LLM_MODEL=               # Override model name for Gemini/OpenAI/local (Claude uses CLAUDE_MODEL)

# Auto-Apply (optional)
# APPLYPILOT_ENABLE_GMAIL=1  # Let the apply agent READ Gmail for verification codes (never send)

# Proxy (optional, for scraping)
# PROXY=host:port:user:pass
